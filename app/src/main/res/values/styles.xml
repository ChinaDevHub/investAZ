<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.InvestAZ.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
    </style>

    <style name="Widget.InvestAZ.GlassCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/radius_large</item>
    </style>

    <style name="Widget.InvestAZ.PriceCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_surface</item>
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.InvestAZ.RangeBar" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:max">100</item>
        <item name="trackThickness">@dimen/range_bar_thickness</item>
        <item name="trackCornerRadius">@dimen/range_bar_corner</item>
        <item name="indicatorTrackGapSize">0dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

</resources>
